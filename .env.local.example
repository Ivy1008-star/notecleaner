# 复制本文件为 .env.local 并填入你的 key（不要提交 .env.local）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------- Stripe 付费墙（测试模式 key 即可跑通）----------
# 私钥（测试 sk_test_ / 正式 sk_live_）
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# 三个档位各对应一个 Stripe Price ID（在 Stripe 后台 Products 里建两个订阅价：
# Pro $9/月、Ultra $29/月，复制它们的 Price ID 填到这里）
STRIPE_PRICE_PRO=price_your_pro_monthly_price_id
STRIPE_PRICE_ULTRA=price_your_ultra_monthly_price_id

# Webhook 签名密钥（本地用 `stripe listen` 拿 whsec_...；线上在 Stripe Webhook 配置页拿）
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# 可选：线上域名，用于拼接支付成功回跳地址（不填则用请求来源）
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
